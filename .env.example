# Self-hosted runtime
SELF_HOST=1
SELF_HOST_DB_PATH=./data/counterpick.sqlite
COUNTERPICK_ADMIN_EMAILS=alebaba4565@gmail.com

# Optional authorized build feed. Do not point this at an unlicensed scraper.
