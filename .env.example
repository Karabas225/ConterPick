DOTA_BUILD_FEED_URL=

# The project is non-commercial and written permission was confirmed by email.
# Set to 1 only when the written permission is archived with the deployment.
D2PT_PERMISSION_CONFIRMED=1

# Optional public URL used for metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
